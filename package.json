{
  "name": "apix-builder-web-extension",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "Chrome side-panel extension for aPix Builder image workflows",
  "scripts": {
    "dev": "npm run sync:templates && vite --host 0.0.0.0 --port 5174",
    "sync:templates": "node scripts/sync-templates.mjs",
    "build": "npm run sync:templates && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4174",
    "test": "vitest run",
    "dist:zip": "npm run build && node scripts/package-release.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.1.0",
    "vitest": "^4.1.8"
  }
}
