{
  "manifest_version": 3,
  "name": "aPix Builder Web Extension",
  "short_name": "aPix Builder",
  "version": "0.1.6",
  "description": "Import images from any webpage and run aPix Builder templates in a Chrome side panel.",
  "permissions": [
    "contextMenus",
    "declarativeNetRequest",
    "downloads",
    "scripting",
    "sidePanel",
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open aPix Builder",
    "default_icon": "icons/icon-48.png"
  },
  "icons": {
    "48": "icons/icon-48.png"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
